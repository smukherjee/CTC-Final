<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Lorry Receipt - {{lr_number}}</title>
    <style>
        @page {
            size: A4;
            margin: 20mm;
        }
        
        @media print {
            body {
                margin: 0;
                padding: 0;
            }
            .no-print {
                display: none;
            }
        }
        
        body {
            font-family: 'Arial', sans-serif;
            font-size: 12px;
            line-height: 1.4;
            color: #000;
            max-width: 210mm;
            margin: 0 auto;
            padding: 10mm;
        }
        
        .header {
            text-align: center;
            margin-bottom: 20px;
            border-bottom: 2px solid #000;
            padding-bottom: 10px;
        }
        
        .company-name {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 5px;
        }
        
        .company-address {
            font-size: 10px;
            color: #666;
        }
        
        .lr-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
            padding: 10px;
            background: #f5f5f5;
            border: 1px solid #000;
        }
        
        .lr-number {
            font-size: 16px;
            font-weight: bold;
        }
        
        .lr-date {
            font-size: 14px;
        }
        
        .section {
            margin-bottom: 15px;
        }
        
        .section-title {
            font-weight: bold;
            font-size: 13px;
            margin-bottom: 8px;
            text-transform: uppercase;
            border-bottom: 1px solid #ccc;
            padding-bottom: 3px;
        }
        
        .row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 10px;
        }
        
        .field {
            margin-bottom: 8px;
        }
        
        .field-label {
            font-weight: bold;
            font-size: 10px;
            color: #666;
            text-transform: uppercase;
        }
        
        .field-value {
            font-size: 12px;
            padding: 3px 0;
            border-bottom: 1px dotted #999;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
        }
        
        th, td {
            border: 1px solid #000;
            padding: 6px 8px;
            text-align: left;
        }
        
        th {
            background: #f0f0f0;
            font-weight: bold;
            font-size: 10px;
            text-transform: uppercase;
        }
        
        td {
            font-size: 11px;
        }
        
        .totals {
            margin-top: 15px;
            padding: 10px;
            background: #f9f9f9;
            border: 1px solid #000;
        }
        
        .totals-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 5px;
        }
        
        .totals-row.grand-total {
            font-weight: bold;
            font-size: 14px;
            border-top: 2px solid #000;
            padding-top: 8px;
            margin-top: 8px;
        }
        
        .footer {
            margin-top: 30px;
            padding-top: 15px;
            border-top: 1px solid #ccc;
        }
        
        .signature-section {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 20px;
            margin-top: 40px;
        }
        
        .signature-box {
            border-top: 1px solid #000;
            padding-top: 5px;
            text-align: center;
            font-size: 10px;
        }
        
        .watermark {
            text-align: center;
            font-size: 10px;
            color: #999;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="company-name">CTC LOGISTICS</div>
        <div class="company-address">
            Transport Services • PAN: XXXXX1234X • GSTIN: 33XXXXX1234X1ZX
        </div>
    </div>
    
    <div class="lr-header">
        <div>
            <div class="lr-number">LR No: {{lr_number}}</div>
        </div>
        <div>
            <div class="lr-date">Date: {{date}}</div>
        </div>
    </div>
    
    <!-- Parties Section -->
    <div class="section">
        <div class="row">
            <div>
                <div class="field">
                    <div class="field-label">Consignor</div>
                    <div class="field-value">{{consignor_name}}</div>
                </div>
                <div class="field">
                    <div class="field-label">From</div>
                    <div class="field-value">{{from}}</div>
                </div>
            </div>
            <div>
                <div class="field">
                    <div class="field-label">Consignee</div>
                    <div class="field-value">{{consignee_name}}</div>
                </div>
                <div class="field">
                    <div class="field-label">To</div>
                    <div class="field-value">{{to}}</div>
                </div>
                {{#if delivery_at}}
                <div class="field">
                    <div class="field-label">Delivery At</div>
                    <div class="field-value">{{delivery_at}}</div>
                </div>
                {{/if}}
            </div>
        </div>
    </div>
    
    <!-- Goods Details Table -->
    <div class="section">
        <div class="section-title">Goods Details</div>
        <table>
            <thead>
                <tr>
                    <th style="width: 80px;">Articles</th>
                    <th>Description</th>
                    <th style="width: 70px;">Weight<br>(QTL)</th>
                    <th style="width: 70px;">Weight<br>(KG)</th>
                    <th style="width: 80px;">Rate/QTL</th>
                    <th style="width: 100px;">Freight (₹)</th>
                    <th style="width: 100px;">Remarks</th>
                </tr>
            </thead>
            <tbody>
                {{#each goods_items}}
                <tr>
                    <td style="text-align: center;">{{this.articles_count}}</td>
                    <td>{{this.description}}</td>
                    <td style="text-align: right;">{{this.weight_qtl}}</td>
                    <td style="text-align: right;">{{this.weight_kg}}</td>
                    <td style="text-align: right;">₹{{this.rate_per_qtl}}</td>
                    <td style="text-align: right;">₹{{this.freight_rs}}.{{this.freight_p}}</td>
                    <td>{{this.remarks}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
    
    <!-- Vehicle & Loading Details -->
    <div class="section">
        <div class="row">
            <div>
                <div class="field">
                    <div class="field-label">Vehicle No.</div>
                    <div class="field-value">{{vehicle_number}}</div>
                </div>
                <div class="field">
                    <div class="field-label">SEAL No.</div>
                    <div class="field-value">{{seal_number}}</div>
                </div>
            </div>
            <div>
                {{#if loading_point_times}}
                <div class="section-title" style="font-size: 11px;">At Loading Point</div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-size: 10px;">
                    <div>
                        <div class="field-label">In Date</div>
                        <div>{{loading_point_times.in_date}}</div>
                    </div>
                    <div>
                        <div class="field-label">In Time</div>
                        <div>{{loading_point_times.in_time}}</div>
                    </div>
                    <div>
                        <div class="field-label">Out Date</div>
                        <div>{{loading_point_times.out_date}}</div>
                    </div>
                    <div>
                        <div class="field-label">Out Time</div>
                        <div>{{loading_point_times.out_time}}</div>
                    </div>
                </div>
                {{/if}}
            </div>
        </div>
    </div>
    
    <!-- Financial Summary -->
    <div class="totals">
        <div class="totals-row">
            <span>Value (Goods):</span>
            <span>₹{{value_rs}}</span>
        </div>
        <div class="totals-row">
            <span>Surcharge:</span>
            <span>₹{{surcharge}}</span>
        </div>
        <div class="totals-row">
            <span>Hamali Charges:</span>
            <span>₹{{hamali_charges}}</span>
        </div>
        <div class="totals-row">
            <span>St. Charges:</span>
            <span>₹{{st_charges}}</span>
        </div>
        <div class="totals-row grand-total">
            <span>TOTAL:</span>
            <span>₹{{total}}</span>
        </div>
    </div>
    
    {{#if booked_on_owners_risk}}
    <div style="margin-top: 15px; padding: 8px; background: #fff3cd; border: 1px solid #ffc107;">
        <strong>⚠️ Booked on Owner's Risk</strong>
    </div>
    {{/if}}
    
    <!-- Footer -->
    <div class="footer">
        <div class="section-title">Terms & Conditions</div>
        <ul style="font-size: 9px; color: #666; margin: 0; padding-left: 20px;">
            <li>The consignee should take delivery within 24 hours of arrival</li>
            <li>Goods are insured as per the declared value</li>
            <li>All disputes subject to local jurisdiction only</li>
        </ul>
        
        <div class="signature-section">
            <div class="signature-box">
                <div style="margin-top: 30px;"></div>
                Consignor's Signature
            </div>
            <div class="signature-box">
                <div style="margin-top: 30px;"></div>
                Driver's Signature
            </div>
            <div class="signature-box">
                <div style="margin-top: 30px;"></div>
                For CTC Logistics
            </div>
        </div>
    </div>
    
    <div class="watermark">
        Generated on {{generated_at}} • System Generated Document
    </div>
</body>
</html>
