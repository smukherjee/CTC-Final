<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Hire Memo - {{hire_memo_no}}</title>
  <style>
    @page {
      size: A4 portrait;
      margin: 8mm;
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
      color: #000;
      background: #fff;
    }

    .page {
      display: flex;
      flex-direction: column;
      gap: 6mm;
    }

    .copy {
      border: 1px solid #000;
      padding: 4mm;
      min-height: calc(50vh - 12mm);
    }

    .copy-title {
      text-align: center;
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
      margin-bottom: 3mm;
      letter-spacing: 0.4px;
    }

    .head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 2mm;
      font-size: 12px;
      font-weight: 700;
    }

    .subhead {
      font-size: 11px;
      font-weight: 700;
      margin-bottom: 3mm;
      border-bottom: 1px solid #000;
      padding-bottom: 1.5mm;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2mm 6mm;
      font-size: 10px;
      margin-bottom: 3mm;
    }

    .line {
      border-bottom: 1px dotted #000;
      padding: 0 1mm;
      min-height: 4mm;
      display: inline-block;
      min-width: 26mm;
      font-weight: 700;
      text-transform: uppercase;
      line-height: 4mm;
      vertical-align: bottom;
    }

    .paragraph {
      font-size: 10px;
      line-height: 1.35;
      margin-bottom: 2.5mm;
    }

    .money {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3mm;
      margin-bottom: 3mm;
    }

    .money-box {
      border: 1px solid #000;
      padding: 2mm;
      font-size: 10px;
    }

    .money-box .label {
      font-weight: 800;
      margin-bottom: 1.2mm;
      text-transform: uppercase;
    }

    .money-box .value {
      font-weight: 700;
      min-height: 4mm;
    }

    .words {
      margin-bottom: 3mm;
      font-size: 10px;
      font-weight: 700;
    }

    .signs {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10mm;
      font-size: 10px;
      margin-top: 4mm;
    }

    .sign-line {
      border-bottom: 1px solid #000;
      margin-top: 10mm;
      margin-bottom: 1mm;
    }

    @media print {
      .copy {
        page-break-inside: avoid;
      }
    }
  </style>
</head>
<body>
  <div class="page">
    <section class="copy">
      <div class="copy-title">Original Copy</div>
      <div class="head">
        <span>Chandra Transport Corporation</span>
        <span>Phone: 044-4272 5261</span>
      </div>
      <div class="subhead">Flat No. 31, BBC Villa Complex, 65, Broadway, Chennai - 600 108.</div>

      <div class="grid">
        <div>Hire Memo No: <span class="line">{{hire_memo_no}}</span></div>
        <div>Date: <span class="line">{{hire_memo_date}}</span></div>
        <div>LR No: <span class="line">{{lr_number}}</span></div>
        <div>LR Date: <span class="line">{{lr_date}}</span></div>
        <div>Vehicle No: <span class="line">{{vehicle_number}}</span></div>
        <div>Driver: <span class="line">{{driver_name}}</span></div>
      </div>

      <div class="paragraph">
        Loaded from <span class="line">{{from_location}}</span> to <span class="line">{{to_location}}</span>.
        Payment at <span class="line">{{payment_location}}</span>. No. of articles: <span class="line">{{articles_count}}</span>.
      </div>

      <div class="money">
        <div class="money-box"><div class="label">Rate Type</div><div class="value">{{rate_type}}</div></div>
        <div class="money-box"><div class="label">Freight Weight</div><div class="value">{{freight_weight}}</div></div>
        <div class="money-box">
          <div class="label">Amounts</div>
          <div class="value">Total: {{total_amount}}</div>
          <div class="value">Advance: {{part_payment}}</div>
          <div class="value">Balance: {{balance}}</div>
        </div>
      </div>

      <div class="words">Amount in words: {{balance_in_words}}</div>

      <div class="paragraph">
        Deductions: Rs {{other_deductions}} on account of {{notes}}.
      </div>

      <div class="signs">
        <div>
          <div class="sign-line"></div>
          <div>For Chandra Transport Corporation</div>
        </div>
        <div>
          <div class="sign-line"></div>
          <div>Driver / Owner Sign (Lic: {{driver_license}})</div>
        </div>
      </div>
    </section>

    <section class="copy">
      <div class="copy-title">Book Copy</div>
      <div class="head">
        <span>Chandra Transport Corporation</span>
        <span>Phone: 044-4272 5261</span>
      </div>
      <div class="subhead">Flat No. 31, BBC Villa Complex, 65, Broadway, Chennai - 600 108.</div>

      <div class="grid">
        <div>Hire Memo No: <span class="line">{{hire_memo_no}}</span></div>
        <div>Date: <span class="line">{{hire_memo_date}}</span></div>
        <div>LR No: <span class="line">{{lr_number}}</span></div>
        <div>LR Date: <span class="line">{{lr_date}}</span></div>
        <div>Vehicle No: <span class="line">{{vehicle_number}}</span></div>
        <div>Driver: <span class="line">{{driver_name}}</span></div>
      </div>

      <div class="paragraph">
        Loaded from <span class="line">{{from_location}}</span> to <span class="line">{{to_location}}</span>.
        Payment at <span class="line">{{payment_location}}</span>. No. of articles: <span class="line">{{articles_count}}</span>.
      </div>

      <div class="money">
        <div class="money-box"><div class="label">Rate Type</div><div class="value">{{rate_type}}</div></div>
        <div class="money-box"><div class="label">Freight Weight</div><div class="value">{{freight_weight}}</div></div>
        <div class="money-box">
          <div class="label">Amounts</div>
          <div class="value">Total: {{total_amount}}</div>
          <div class="value">Advance: {{part_payment}}</div>
          <div class="value">Balance: {{balance}}</div>
        </div>
      </div>

      <div class="words">Amount in words: {{balance_in_words}}</div>

      <div class="paragraph">
        Deductions: Rs {{other_deductions}} on account of {{notes}}.
      </div>

      <div class="signs">
        <div>
          <div class="sign-line"></div>
          <div>For Chandra Transport Corporation</div>
        </div>
        <div>
          <div class="sign-line"></div>
          <div>Driver / Owner Sign (Lic: {{driver_license}})</div>
        </div>
      </div>
    </section>
  </div>
</body>
</html>
