<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Voucher {{id}}</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 16px; color: #111; }
    .card { border: 1px solid #000; padding: 12px; max-width: 700px; }
    .head { display: flex; justify-content: space-between; border-bottom: 1px solid #000; padding-bottom: 8px; margin-bottom: 8px; }
    .title { font-size: 18px; font-weight: 700; }
    .row { display: flex; justify-content: space-between; margin: 4px 0; }
    .label { font-weight: 700; }
    .amount { font-size: 20px; font-weight: 700; }
    .sign { margin-top: 40px; display: flex; justify-content: space-between; }
    .line { width: 220px; border-top: 1px solid #000; text-align: center; padding-top: 4px; }
  </style>
</head>
<body>
  <div class="card">
    <div class="head">
      <div>
        <div class="title">Debit Voucher</div>
        <div>Chandra Transport Corporation</div>
      </div>
      <div>#{{id}}</div>
    </div>

    <div class="row"><span class="label">Date:</span><span>{{date}}</span></div>
    <div class="row"><span class="label">Voucher Type:</span><span>{{voucher_type}}</span></div>
    <div class="row"><span class="label">Reference:</span><span>{{reference_type}} / {{reference_id}}</span></div>
    <div class="row"><span class="label">Narration:</span><span>{{narration}}</span></div>
    <div class="row amount"><span>Amount</span><span>Rs. {{amount}}</span></div>
    <div class="row"><span class="label">Amount in words:</span><span>{{amount_in_words}}</span></div>

    <div class="sign">
      <div class="line">Prepared By</div>
      <div class="line">Authorised Signatory</div>
    </div>
  </div>
</body>
</html>
